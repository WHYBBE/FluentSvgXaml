<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTemplate x:Key="HorizontalTabControl" TargetType="{x:Type TabControl}">
        <ControlTemplate.Resources>
            <Style TargetType="{x:Type TabItem}">
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TabItem}">
                            <Border x:Name="Bd"
                                    Padding="14,6"
                                    CornerRadius="4"
                                    Background="Transparent"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter x:Name="cnt"
                                                  ContentSource="Header"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Center"
                                                  TextBlock.FontSize="15"
                                                  TextBlock.Foreground="{StaticResource AppTextSecondary}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource AppNavHover}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource AppNavSelected}"/>
                                    <Setter TargetName="cnt" Property="TextBlock.FontWeight" Value="SemiBold"/>
                                    <Setter TargetName="cnt" Property="TextBlock.Foreground" Value="{StaticResource AppTextPrimary}"/>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsSelected" Value="True"/>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource AppNavSelected}"/>
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ControlTemplate.Resources>
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" IsItemsHost="True" Orientation="Horizontal" Margin="8,8,8,0"/>
            <ContentPresenter Content="{TemplateBinding SelectedContent}" Margin="8,8,8,8"/>
        </DockPanel>
    </ControlTemplate>
</ResourceDictionary>
