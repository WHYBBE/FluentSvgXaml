<Page x:Class="FluentSvgXaml.DirectoryConverterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:FluentSvgXaml"
      Title="Directory Converter Page">
    <DockPanel LastChildFill="True">
        <StackPanel Margin="0,8"
                    HorizontalAlignment="Center"
                    DockPanel.Dock="Bottom"
                    Orientation="Horizontal">
            <Button Name="btnConvert"
                    Padding="24,6"
                    Click="OnConvertClick"
                    Content="Convert" />
        </StackPanel>
        <Border Margin="0,0,0,8"
                Background="{StaticResource AppCardBackground}"
                BorderBrush="{StaticResource AppCardBorder}"
                BorderThickness="1"
                CornerRadius="4"
                DockPanel.Dock="Bottom">
            <StackPanel>
                <Border Style="{StaticResource CardHeader}">
                    <TextBlock FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AppTextPrimary}"
                               Text="Status" />
                </Border>
                <StackPanel Margin="12">
                    <DockPanel>
                        <TextBlock Name="statusTitle"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AppTextPrimary}"
                                   Text="Not Ready"
                                   TextAlignment="Center" />
                        <local:CircularProgressBar x:Name="progressBar"
                                                   Height="18"
                                                   DockPanel.Dock="Right"
                                                   Foreground="{StaticResource AppAccent}"
                                                   StartupDelay="0" />
                    </DockPanel>
                    <TextBlock Name="statusText"
                               Foreground="{StaticResource AppTextSecondary}"
                               TextAlignment="Center"
                               TextWrapping="Wrap">
                        Select an input directory of SVG files for conversion.
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Border>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="8">
                <TextBlock Margin="0,0,0,12"
                           Foreground="{StaticResource AppTextSecondary}"
                           TextWrapping="Wrap">
                    This provides the conversion of Scalable Vector Graphics (SVG)
                    files in a<Bold>local</Bold>
                    directory to images and/or XAML (WPF only).</TextBlock>

                <TextBlock Margin="0,0,0,4"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AppTextPrimary}"
                           Text="Source Directory" />
                <DockPanel Margin="0,0,0,8" LastChildFill="True">
                    <Button Name="btnSourceDir"
                            Margin="4,0,0,0"
                            Click="OnSourceDirClick"
                            Content="Browse..."
                            DockPanel.Dock="Right" />
                    <AdornerDecorator>
                        <TextBox Name="txtSourceDir" TextChanged="OnDirTextChanged">
                            <local:WatermarkService.Watermark>
                                <TextBlock Text="Type or browse to select source directory of SVG files" />
                            </local:WatermarkService.Watermark>
                        </TextBox>
                    </AdornerDecorator>
                </DockPanel>

                <TextBlock Margin="0,0,0,4"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AppTextPrimary}"
                           Text="Output Directory" />
                <DockPanel Margin="0,0,0,8" LastChildFill="True">
                    <Button Name="btnOutputDir"
                            Margin="4,0,0,0"
                            Click="OnOutputDirClick"
                            Content="Browse..."
                            DockPanel.Dock="Right" />
                    <AdornerDecorator>
                        <TextBox Name="txtOutputDir" TextChanged="OnDirTextChanged">
                            <local:WatermarkService.Watermark>
                                <TextBlock Text="Type or browse to select the output directory" />
                            </local:WatermarkService.Watermark>
                        </TextBox>
                    </AdornerDecorator>
                </DockPanel>

                <Border Margin="0,0,0,8"
                        Padding="10,8"
                        Background="#100078D7"
                        BorderBrush="{StaticResource AppAccent}"
                        BorderThickness="1"
                        CornerRadius="4">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,4" Orientation="Horizontal">
                            <TextBlock Margin="0,0,6,0"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="16"
                                       Foreground="{StaticResource AppAccent}"
                                       Text="&#xE946;" />
                            <TextBlock FontWeight="SemiBold"
                                       Foreground="{StaticResource AppTextPrimary}"
                                       Text="Note" />
                        </StackPanel>
                        <TextBlock Foreground="{StaticResource AppTextSecondary}" TextWrapping="Wrap">
                            <Run Text="If the output directory is not specified, the source directory will be used." /><LineBreak />
                            <Run Text="If the source directory is " /><Bold>read-only</Bold><Run Text=" media, the output directory is required." />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource AppCardBackground}"
                        BorderBrush="{StaticResource AppCardBorder}"
                        BorderThickness="1"
                        CornerRadius="4">
                    <StackPanel>
                        <Border Style="{StaticResource CardHeader}">
                            <TextBlock FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AppTextPrimary}"
                                       Text="Directory Options" />
                        </Border>
                        <StackPanel Margin="12">
                            <CheckBox Name="chkRecursive" Margin="0,0,0,4">
                                <TextBlock Text="Recursive" />
                            </CheckBox>
                            <CheckBox Name="chkContinueOnError" IsChecked="True">
                                <TextBlock Foreground="{StaticResource AppTextSecondary}"
                                           Text="Continue if an error occurs in the conversion of a file."
                                           TextWrapping="Wrap" />
                            </CheckBox>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Page>
