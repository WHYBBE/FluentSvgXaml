<Page x:Class="FluentSvgXaml.DirectoryConverterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:FluentSvgXaml"
    Title="Directory Converter Page">
    <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,8" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Name="btnConvert" Content="Convert" Padding="24,6" Click="OnConvertClick"/>
        </StackPanel>
        <Border DockPanel.Dock="Bottom" CornerRadius="4" Margin="0,0,0,8" Background="{StaticResource AppCardBackground}" BorderBrush="{StaticResource AppCardBorder}" BorderThickness="1">
            <StackPanel>
                <Border Style="{StaticResource CardHeader}">
                    <TextBlock Text="Status" Foreground="{StaticResource AppTextPrimary}" FontSize="13" FontWeight="SemiBold"/>
                </Border>
                <StackPanel Margin="12">
                    <DockPanel>
                        <TextBlock Name="statusTitle" Text="Not Ready" FontWeight="SemiBold" TextAlignment="Center" Foreground="{StaticResource AppTextPrimary}"/>
                        <local:CircularProgressBar x:Name="progressBar" DockPanel.Dock="Right" Height="18" StartupDelay="0" Foreground="{StaticResource AppAccent}"/>
                    </DockPanel>
                    <TextBlock Name="statusText" TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource AppTextSecondary}">
                        Select an input directory of SVG files for conversion.
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="8">
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource AppTextSecondary}" Margin="0,0,0,12">
                    This provides the conversion of Scalable Vector Graphics (SVG)
                    files in a <Bold>local</Bold> directory to images and/or XAML (WPF only).
                </TextBlock>

                <TextBlock Text="Source Directory" FontWeight="SemiBold" Foreground="{StaticResource AppTextPrimary}" Margin="0,0,0,4"/>
                <DockPanel LastChildFill="True" Margin="0,0,0,8">
                    <Button Name="btnSourceDir" DockPanel.Dock="Right" Content="Browse..." Click="OnSourceDirClick" Margin="4,0,0,0"/>
                    <AdornerDecorator>
                        <TextBox Name="txtSourceDir" TextChanged="OnDirTextChanged">
                            <local:WatermarkService.Watermark>
                                <TextBlock Text="Type or browse to select source directory of SVG files"/>
                            </local:WatermarkService.Watermark>
                        </TextBox>
                    </AdornerDecorator>
                </DockPanel>

                <TextBlock Text="Output Directory" FontWeight="SemiBold" Foreground="{StaticResource AppTextPrimary}" Margin="0,0,0,4"/>
                <DockPanel LastChildFill="True" Margin="0,0,0,8">
                    <Button Name="btnOutputDir" DockPanel.Dock="Right" Content="Browse..." Click="OnOutputDirClick" Margin="4,0,0,0"/>
                    <AdornerDecorator>
                        <TextBox Name="txtOutputDir" TextChanged="OnDirTextChanged">
                            <local:WatermarkService.Watermark>
                                <TextBlock Text="Type or browse to select the output directory"/>
                            </local:WatermarkService.Watermark>
                        </TextBox>
                    </AdornerDecorator>
                </DockPanel>

                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource AppTextSecondary}" Margin="0,0,0,8">
                    <Bold>NOTE:</Bold> If the output directory is not specified, the source directory will be used.
                    If the source directory is <Bold>read-only</Bold> media, the output directory is required.
                </TextBlock>

                <Border CornerRadius="4" Background="{StaticResource AppCardBackground}" BorderBrush="{StaticResource AppCardBorder}" BorderThickness="1">
                    <StackPanel>
                        <Border Style="{StaticResource CardHeader}">
                            <TextBlock Text="Directory Options" Foreground="{StaticResource AppTextPrimary}" FontSize="13" FontWeight="SemiBold"/>
                        </Border>
                        <StackPanel Margin="12">
                            <CheckBox Name="chkRecursive" Margin="0,0,0,4">
                                <TextBlock Text="Recursive"/>
                            </CheckBox>
                            <CheckBox Name="chkContinueOnError" IsChecked="True">
                                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource AppTextSecondary}" Text="Continue if an error occurs in the conversion of a file."/>
                            </CheckBox>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Page>
