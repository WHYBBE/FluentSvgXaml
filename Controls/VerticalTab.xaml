<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTemplate x:Key="VerticalTabControl" TargetType="{x:Type TabControl}">
        <ControlTemplate.Resources>
            <Style TargetType="{x:Type TabItem}">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TabItem}">
                            <Border x:Name="Bd"
                                    Height="38"
                                    Margin="4,2"
                                    Padding="12,0"
                                    Background="Transparent"
                                    CornerRadius="4"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter x:Name="cnt"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"
                                                  ContentSource="Header"
                                                  TextBlock.FontSize="15"
                                                  TextBlock.Foreground="{StaticResource AppTextSecondary}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource AppNavHover}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource AppNavSelected}" />
                                    <Setter TargetName="cnt" Property="TextBlock.FontWeight" Value="SemiBold" />
                                    <Setter TargetName="cnt" Property="TextBlock.Foreground" Value="{StaticResource AppTextPrimary}" />
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsSelected" Value="True" />
                                        <Condition Property="IsMouseOver" Value="True" />
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource AppNavSelected}" />
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ControlTemplate.Resources>
        <DockPanel>
            <StackPanel Width="150"
                        Margin="0,8,0,8"
                        DockPanel.Dock="Left"
                        IsItemsHost="True" />
            <ContentPresenter Margin="12,8,8,8" Content="{TemplateBinding SelectedContent}" />
        </DockPanel>
    </ControlTemplate>
</ResourceDictionary>
