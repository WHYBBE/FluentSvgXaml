<Page x:Class="FluentSvgXaml.FileConverterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:FluentSvgXaml"
    Title="Files Converter Page">
    <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,8" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Name="btnConvert" Content="Convert" Padding="24,6" Click="OnConvertClick"/>
        </StackPanel>
        <Border DockPanel.Dock="Bottom" CornerRadius="4" Margin="0,0,0,8" Background="{StaticResource AppCardBackground}" BorderBrush="{StaticResource AppCardBorder}" BorderThickness="1">
            <StackPanel>
                <Border Style="{StaticResource CardHeader}">
                    <TextBlock Text="Status" Foreground="{StaticResource AppTextPrimary}" FontSize="13" FontWeight="SemiBold"/>
                </Border>
                <StackPanel Margin="12">
                    <DockPanel>
                        <TextBlock Name="statusTitle" Text="Not Ready" FontWeight="SemiBold" TextAlignment="Center" Foreground="{StaticResource AppTextPrimary}"/>
                        <local:CircularProgressBar x:Name="progressBar" DockPanel.Dock="Right" Height="18" StartupDelay="0" Foreground="{StaticResource AppAccent}"/>
                    </DockPanel>
                    <TextBlock Name="statusText" TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource AppTextSecondary}">
                        Select an input SVG file for conversion.
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="8">
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource AppTextSecondary}" Margin="0,0,0,12">
                    This provides the conversion of Scalable Vector Graphics (SVG) files to images and/or XAML (WPF only).
                </TextBlock>

                <TextBlock Text="Source File" FontWeight="SemiBold" Foreground="{StaticResource AppTextPrimary}" Margin="0,0,0,4"/>
                <DockPanel LastChildFill="True" Margin="0,0,0,8">
                    <Button Name="btnSourceFile" DockPanel.Dock="Right" Content="Browse..." Click="OnSourceFileClick" Margin="4,0,0,0"/>
                    <AdornerDecorator>
                        <TextBox Name="txtSourceFile" TextChanged="OnSourceOutputTextChanged"
                                 Drop="OnSourceFileDrop" PreviewDragEnter="OnSourceFilePreviewDragEnter"
                                 PreviewDragOver="OnSourceFilePreviewDragOver">
                            <local:WatermarkService.Watermark>
                                <TextBlock Text="Type, browse to select or drag/drop an SVG file"/>
                            </local:WatermarkService.Watermark>
                        </TextBox>
                    </AdornerDecorator>
                </DockPanel>

                <TextBlock Text="Output Directory" FontWeight="SemiBold" Foreground="{StaticResource AppTextPrimary}" Margin="0,0,0,4"/>
                <DockPanel LastChildFill="True" Margin="0,0,0,8">
                    <Button Name="btnOutputDir" DockPanel.Dock="Right" Content="Browse..." Click="OnOutputDirClick" Margin="4,0,0,0"/>
                    <AdornerDecorator>
                        <TextBox Name="txtOutputDir" TextChanged="OnSourceOutputTextChanged">
                            <local:WatermarkService.Watermark>
                                <TextBlock Text="Type or browse to select the output directory"/>
                            </local:WatermarkService.Watermark>
                        </TextBox>
                    </AdornerDecorator>
                </DockPanel>

                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource AppTextSecondary}">
                    <Bold>NOTE:</Bold> If the output directory is not specified, the converted file
                    will be saved in the same directory as the source file.
                    If the source directory is <Bold>read-only</Bold> media or a <Bold>web file</Bold>,
                    the output directory is required.
                </TextBlock>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Page>
