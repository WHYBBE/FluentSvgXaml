<Page x:Class="FluentSvgXaml.Pages.StartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Start Page">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8">
            <StackPanel Margin="0,0,0,16" Orientation="Horizontal">
                <Image Width="48"
                       Height="48"
                       Margin="0,0,12,0"
                       VerticalAlignment="Center"
                       Source="pack://application:,,,/images/SharpVectors.png" />
                <TextBlock VerticalAlignment="Center"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AppTextPrimary}"
                           Text="SVG-WPF Converter" />
            </StackPanel>

            <TextBlock Margin="0,0,0,16"
                       Foreground="{StaticResource AppTextSecondary}"
                       TextWrapping="Wrap">
                This program converts Scalable Vector Graphics (SVG) files to images and XAML (WPF only).
                It can convert a single file or multiple files in a directory.
            </TextBlock>

            <Border Margin="0,0,0,8"
                    Background="{StaticResource AppCardBackground}"
                    BorderBrush="{StaticResource AppCardBorder}"
                    BorderThickness="1"
                    CornerRadius="4">
                <StackPanel>
                    <Border Style="{StaticResource CardHeader}">
                        <TextBlock FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AppTextPrimary}"
                                   Text="Quick Help" />
                    </Border>
                    <StackPanel Margin="12">
                        <TextBlock FontWeight="SemiBold"
                                   Foreground="{StaticResource AppTextPrimary}"
                                   Text="Files Page" />
                        <TextBlock Margin="16,2,0,6"
                                   Foreground="{StaticResource AppTextSecondary}"
                                   Text="Use this to convert an SVG file (local or web)."
                                   TextWrapping="Wrap" />
                        <TextBlock FontWeight="SemiBold"
                                   Foreground="{StaticResource AppTextPrimary}"
                                   Text="Files List Page" />
                        <TextBlock Margin="16,2,0,6"
                                   Foreground="{StaticResource AppTextSecondary}"
                                   Text="Use this to convert a list of SVG files (local only)."
                                   TextWrapping="Wrap" />
                        <TextBlock FontWeight="SemiBold"
                                   Foreground="{StaticResource AppTextPrimary}"
                                   Text="Directories Page" />
                        <TextBlock Margin="16,2,0,6"
                                   Foreground="{StaticResource AppTextSecondary}"
                                   Text="Use this to convert the SVG files in a directory (and optionally its sub-directories)."
                                   TextWrapping="Wrap" />
                        <TextBlock FontWeight="SemiBold"
                                   Foreground="{StaticResource AppTextPrimary}"
                                   Text="Options Page" />
                        <TextBlock Margin="16,2,0,6"
                                   Foreground="{StaticResource AppTextSecondary}"
                                   Text="Provides the general conversion options available to this program."
                                   TextWrapping="Wrap" />
                        <TextBlock FontWeight="SemiBold"
                                   Foreground="{StaticResource AppTextPrimary}"
                                   Text="Help Page" />
                        <TextBlock Margin="16,2,0,6"
                                   Foreground="{StaticResource AppTextSecondary}"
                                   Text="Provides detailed help on how to use this program."
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource AppCardBackground}"
                    BorderBrush="{StaticResource AppCardBorder}"
                    BorderThickness="1"
                    CornerRadius="4">
                <StackPanel>
                    <Border Style="{StaticResource CardHeader}">
                        <TextBlock FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AppTextPrimary}"
                                   Text="About: SharpVectors Reloaded" />
                    </Border>
                    <StackPanel Margin="12">
                        <TextBlock Foreground="{StaticResource AppTextPrimary}" TextWrapping="Wrap">
                            This program is part of the SharpVectors Reloaded library,
                            an open source .NET library for SVG licensed under the New BSD License.
                        </TextBlock>
                        <TextBlock Margin="0,8,0,0"
                                   TextAlignment="Right"
                                   ToolTip="https://github.com/ElinamLLC/SharpVectors">
                            <Hyperlink NavigateUri="https://github.com/ElinamLLC/SharpVectors">
                                GitHub: SharpVectors Reloaded Project
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
