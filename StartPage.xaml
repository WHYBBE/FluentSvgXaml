<Page x:Class="SharpVectors.Converters.StartPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Start Page">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="8">
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,16" Foreground="{StaticResource AppTextSecondary}">
                This program converts Scalable Vector Graphics (SVG) files to images and XAML (WPF only).
                It can convert a single file or multiple files in a directory.
            </TextBlock>

            <Border CornerRadius="4" Background="{StaticResource AppCardBackground}" BorderBrush="{StaticResource AppCardBorder}" BorderThickness="1" Margin="0,0,0,8">
                <StackPanel>
                    <Border Style="{StaticResource CardHeader}">
                        <TextBlock Text="Quick Help" Foreground="{StaticResource AppTextPrimary}" FontSize="13" FontWeight="SemiBold"/>
                    </Border>
                    <StackPanel Margin="12">
                        <TextBlock FontWeight="SemiBold" Foreground="{StaticResource AppTextPrimary}" Text="Files Page"/>
                        <TextBlock Margin="16,2,0,6" TextWrapping="Wrap" Foreground="{StaticResource AppTextSecondary}" Text="Use this to convert an SVG file (local or web)."/>
                        <TextBlock FontWeight="SemiBold" Foreground="{StaticResource AppTextPrimary}" Text="Files List Page"/>
                        <TextBlock Margin="16,2,0,6" TextWrapping="Wrap" Foreground="{StaticResource AppTextSecondary}" Text="Use this to convert a list of SVG files (local only)."/>
                        <TextBlock FontWeight="SemiBold" Foreground="{StaticResource AppTextPrimary}" Text="Directories Page"/>
                        <TextBlock Margin="16,2,0,6" TextWrapping="Wrap" Foreground="{StaticResource AppTextSecondary}" Text="Use this to convert the SVG files in a directory (and optionally its sub-directories)."/>
                        <TextBlock FontWeight="SemiBold" Foreground="{StaticResource AppTextPrimary}" Text="Options Page"/>
                        <TextBlock Margin="16,2,0,6" TextWrapping="Wrap" Foreground="{StaticResource AppTextSecondary}" Text="Provides the general conversion options available to this program."/>
                        <TextBlock FontWeight="SemiBold" Foreground="{StaticResource AppTextPrimary}" Text="Help Page"/>
                        <TextBlock Margin="16,2,0,6" TextWrapping="Wrap" Foreground="{StaticResource AppTextSecondary}" Text="Provides detailed help on how to use this program."/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border CornerRadius="4" Background="{StaticResource AppCardBackground}" BorderBrush="{StaticResource AppCardBorder}" BorderThickness="1">
                <StackPanel>
                    <Border Style="{StaticResource CardHeader}">
                        <TextBlock Text="About: SharpVectors Reloaded" Foreground="{StaticResource AppTextPrimary}" FontSize="13" FontWeight="SemiBold"/>
                    </Border>
                    <StackPanel Margin="12">
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource AppTextPrimary}">
                            This program is part of the SharpVectors Reloaded library,
                            an open source .NET library for SVG licensed under the New BSD License.
                        </TextBlock>
                        <TextBlock Margin="0,8,0,0" TextAlignment="Right" ToolTip="https://github.com/ElinamLLC/SharpVectors">
                            <Hyperlink NavigateUri="https://github.com/ElinamLLC/SharpVectors">
                                GitHub: SharpVectors Reloaded Project
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
