<Page x:Class="SharpVectors.Converters.StartPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Start Page" Height="518" Width="475" VerticalAlignment="Stretch" HorizontalAlignment="Left">
    <Page.Resources>
        <Style x:Key="GroupBoxHeader" TargetType="{x:Type Border}">
            <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
            <Setter Property="TextBlock.Style" Value="{StaticResource BodyStrongTextBlockStyle}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
    </Page.Resources>
    <DockPanel LastChildFill="True">
        <GroupBox DockPanel.Dock="Bottom" Padding="8" Margin="8">
            <GroupBox.Header>
                <Border Style="{StaticResource GroupBoxHeader}">
                    <TextBlock Text="About: SharpVectors Reloaded"/>
                </Border>
            </GroupBox.Header>
            <StackPanel Orientation="Vertical">
                <TextBlock Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap">
                    <Run>
                        This program is part of the SharpVectors Reloaded library,
                        an open source .NET library for SVG licensed under the New BSD License.
                    </Run>
                </TextBlock>
                <TextBlock Margin="4,16,4,4" Style="{StaticResource BodyTextBlockStyle}" TextAlignment="Right" ToolTip="https://github.com/ElinamLLC/SharpVectors">
                    <Hyperlink NavigateUri="https://github.com/ElinamLLC/SharpVectors">
                        GitHub: SharpVectors Reloaded Project
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
        </GroupBox>
        <Grid VerticalAlignment="Top" RowDefinitions="Auto,Auto,12,Auto">
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <Image Source="Images/SharpVectors.png" Width="32" Height="32"/>
                <TextBlock Text="SVG-WPF Converter" Padding="8" Margin="4"
                           Style="{StaticResource TitleTextBlockStyle}"/>
            </StackPanel>
            <TextBlock Grid.Row="1" Padding="8" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap">
                <Run>
                    This program converts Scalable Vector Graphics (SVG) files to
                    images and XAML (WPF only).
                </Run>
                <LineBreak/>
                <Run>
                    It can convert a single file or multiple files in a directory.
                </Run>
                <LineBreak/>
                <LineBreak/>
                <Bold>NOTE:&#160;</Bold>
                <Run>
                    Currently, Silverlight is not supported. This program converts to only low-level WPF objects such as
                    Drawing and Geometry, which are not supported by Silverlight.
                </Run>
            </TextBlock>
            <GroupBox Grid.Row="3" Padding="8" Margin="8">
                <GroupBox.Header>
                    <Border Style="{StaticResource GroupBoxHeader}">
                        <TextBlock Text="Quick Help"/>
                    </Border>
                </GroupBox.Header>
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="Files Page" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    <TextBlock Margin="32,4,4,4" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap">
                        <Run>Use this to convert an SVG file (local or web).</Run>
                    </TextBlock>
                    <TextBlock Text="Files List Page" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    <TextBlock Margin="32,4,4,4" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap">
                        <Run>Use this to convert a list of SVG files (local only).</Run>
                    </TextBlock>
                    <TextBlock Text="Directories Page" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    <TextBlock Margin="32,4,4,4" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap">
                        <Run>Use this to convert the SVG files in a directory (and optional its sub-directories).</Run>
                    </TextBlock>
                    <TextBlock Text="Options Page" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    <TextBlock Margin="32,4,4,4" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap">
                        <Run>
                            Provides the general conversion options available to this program.
                            Additional options are available on the files and directories pages.
                        </Run>
                    </TextBlock>
                    <TextBlock Text="Help Page" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    <TextBlock Margin="32,4,4,4" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap">
                        <Run>Provides detailed help on how to use this program.</Run>
                    </TextBlock>
                </StackPanel>
            </GroupBox>
        </Grid>
    </DockPanel>
</Page>
