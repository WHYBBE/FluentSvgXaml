<Window x:Class="SharpVectors.Converters.ConverterWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:local="clr-namespace:SharpVectors.Converters"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="SvgXaml" Height="300" Width="300" WindowStartupLocation="CenterScreen">
    <DockPanel LastChildFill="True">
        <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorSecondaryBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource OverlayCornerRadius}"
                SnapsToDevicePixels="True" DockPanel.Dock="Bottom" Padding="8,4">
            <DockPanel>
                <StackPanel Height="32" DockPanel.Dock="Left"
                            Orientation="Horizontal" HorizontalAlignment="Left">
                    <local:CircularProgressBar x:Name="progressBar" Margin="4,0" Height="20" StartupDelay="0"
                                              Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                </StackPanel>
                <StackPanel Height="32" DockPanel.Dock="Right"
                            Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Name="btnClose" Style="{DynamicResource AccentButtonStyle}"
                            Padding="12,4" Margin="4"
                            Content="Close" VerticalAlignment="Center" Click="OnClickClosed"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Frame Name="frameConverter" NavigationUIVisibility="Hidden" Margin="4"/>
    </DockPanel>
</Window>
