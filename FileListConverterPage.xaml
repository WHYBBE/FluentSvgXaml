<Page x:Class="SharpVectors.Converters.FileListConverterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:SharpVectors.Converters"
    Title="Files List Converter Page">
    <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,8" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Name="btnConvert" Content="Convert" Padding="24,6" Click="OnConvertClick"/>
        </StackPanel>
        <Border DockPanel.Dock="Bottom" CornerRadius="4" Margin="0,0,0,8" Background="{StaticResource AppCardBackground}" BorderBrush="{StaticResource AppCardBorder}" BorderThickness="1">
            <StackPanel>
                <Border Style="{StaticResource CardHeader}">
                    <TextBlock Text="Status" Foreground="{StaticResource AppTextPrimary}" FontSize="13" FontWeight="SemiBold"/>
                </Border>
                <StackPanel Margin="12">
                    <DockPanel>
                        <TextBlock Name="statusTitle" Text="Not Ready" FontWeight="SemiBold" TextAlignment="Center" Foreground="{StaticResource AppTextPrimary}"/>
                        <local:CircularProgressBar x:Name="progressBar" DockPanel.Dock="Right" Height="18" StartupDelay="0" Foreground="{StaticResource AppAccent}"/>
                    </DockPanel>
                    <TextBlock Name="statusText" TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource AppTextSecondary}">
                        Select an input SVG file for conversion.
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="8">
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource AppTextSecondary}" Margin="0,0,0,12">
                    This provides the conversion of a list of Scalable Vector Graphics (SVG) files to images and/or XAML (WPF only).
                </TextBlock>

                <TextBlock Text="Source Files" FontWeight="SemiBold" Foreground="{StaticResource AppTextPrimary}" Margin="0,0,0,4"/>
                <DockPanel LastChildFill="True" Margin="0,0,0,8">
                    <StackPanel DockPanel.Dock="Right" Orientation="Vertical" Margin="4,0,0,0">
                        <Button Name="btnSourceFile" Padding="6" Content="Browse..." Click="OnSourceAddClick" Margin="0,0,0,4"/>
                        <Button Name="btnRemoveSourceFile" Padding="6" Content="Remove" IsEnabled="False" Click="OnSourceRemoveClick" Margin="0,0,0,4"/>
                        <Button Name="btnClearSourceFile" Padding="6" Content="Clear" IsEnabled="False" Click="OnSourceClearClick" Margin="0,0,0,8"/>
                        <Border CornerRadius="4" Padding="8,4" Background="{StaticResource AppCardHeaderBackground}" BorderBrush="{StaticResource AppCardBorder}" BorderThickness="1">
                            <TextBlock Name="txtFileCount" Text="0" TextAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AppTextPrimary}"/>
                        </Border>
                    </StackPanel>
                    <AdornerDecorator>
                        <ListBox Name="lstSourceFile" Height="120" SelectionMode="Single" AllowDrop="True"
                                 Drop="OnSourceFileDrop" PreviewDragEnter="OnSourceFilePreviewDragEnter"
                                 PreviewDragOver="OnSourceFilePreviewDragOver"
                                 SelectionChanged="OnSourceSelectionChanged" SourceUpdated="OnSourceUpdated">
                            <local:WatermarkService.Watermark>
                                <TextBlock Text="Browse to select or drag/drop the input SVG files"/>
                            </local:WatermarkService.Watermark>
                        </ListBox>
                    </AdornerDecorator>
                </DockPanel>

                <TextBlock Text="Output Directory" FontWeight="SemiBold" Foreground="{StaticResource AppTextPrimary}" Margin="0,0,0,4"/>
                <DockPanel LastChildFill="True" Margin="0,0,0,8">
                    <Button Name="btnOutputDir" DockPanel.Dock="Right" Content="Browse..." Click="OnOutputDirClick" Margin="4,0,0,0"/>
                    <AdornerDecorator>
                        <TextBox Name="txtOutputDir" TextChanged="OnDirTextChanged">
                            <local:WatermarkService.Watermark>
                                <TextBlock Text="Type or browse to select the output directory"/>
                            </local:WatermarkService.Watermark>
                        </TextBox>
                    </AdornerDecorator>
                </DockPanel>

                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource AppTextSecondary}" Margin="0,0,0,8">
                    <Bold>NOTE:</Bold> If the output directory is not specified, the converted file
                    will be saved in the same directory as the source file.
                    If the source directory is <Bold>read-only</Bold> media, the output directory is required.
                </TextBlock>

                <Border CornerRadius="4" Background="{StaticResource AppCardBackground}" BorderBrush="{StaticResource AppCardBorder}" BorderThickness="1">
                    <StackPanel>
                        <Border Style="{StaticResource CardHeader}">
                            <TextBlock Text="File List Options" Foreground="{StaticResource AppTextPrimary}" FontSize="13" FontWeight="SemiBold"/>
                        </Border>
                        <StackPanel Margin="12">
                            <CheckBox Name="chkContinueOnError" IsChecked="True">
                                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource AppTextSecondary}" Text="Continue if an error occurs in the conversion of a file."/>
                            </CheckBox>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Page>
