<Page x:Class="FluentSvgXaml.FileListConverterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:FluentSvgXaml"
      Title="Files List Converter Page">
    <DockPanel LastChildFill="True">
        <StackPanel Margin="0,8"
                    HorizontalAlignment="Center"
                    DockPanel.Dock="Bottom"
                    Orientation="Horizontal">
            <Button Name="btnConvert"
                    Padding="24,6"
                    Click="OnConvertClick"
                    Content="Convert" />
        </StackPanel>
        <Border Margin="0,0,0,8"
                Background="{StaticResource AppCardBackground}"
                BorderBrush="{StaticResource AppCardBorder}"
                BorderThickness="1"
                CornerRadius="4"
                DockPanel.Dock="Bottom">
            <StackPanel>
                <Border Style="{StaticResource CardHeader}">
                    <TextBlock FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AppTextPrimary}"
                               Text="Status" />
                </Border>
                <StackPanel Margin="12">
                    <DockPanel>
                        <TextBlock Name="statusTitle"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AppTextPrimary}"
                                   Text="Not Ready"
                                   TextAlignment="Center" />
                        <local:CircularProgressBar x:Name="progressBar"
                                                   Height="18"
                                                   DockPanel.Dock="Right"
                                                   Foreground="{StaticResource AppAccent}"
                                                   StartupDelay="0" />
                    </DockPanel>
                    <TextBlock Name="statusText"
                               Foreground="{StaticResource AppTextSecondary}"
                               TextAlignment="Center"
                               TextWrapping="Wrap">
                        Select an input SVG file for conversion.
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Border>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="8">
                <TextBlock Margin="0,0,0,12"
                           Foreground="{StaticResource AppTextSecondary}"
                           TextWrapping="Wrap">
                    This provides the conversion of a list of Scalable Vector Graphics (SVG) files to images and/or XAML (WPF only).
                </TextBlock>

                <TextBlock Margin="0,0,0,4"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AppTextPrimary}"
                           Text="Source Files" />
                <DockPanel Margin="0,0,0,8" LastChildFill="True">
                    <StackPanel Margin="4,0,0,0"
                                DockPanel.Dock="Right"
                                Orientation="Vertical">
                        <Button Name="btnSourceFile"
                                Margin="0,0,0,4"
                                Padding="6"
                                Click="OnSourceAddClick"
                                Content="Browse..." />
                        <Button Name="btnRemoveSourceFile"
                                Margin="0,0,0,4"
                                Padding="6"
                                Click="OnSourceRemoveClick"
                                Content="Remove"
                                IsEnabled="False" />
                        <Button Name="btnClearSourceFile"
                                Margin="0,0,0,8"
                                Padding="6"
                                Click="OnSourceClearClick"
                                Content="Clear"
                                IsEnabled="False" />
                        <Border Padding="8,4"
                                Background="{StaticResource AppCardHeaderBackground}"
                                BorderBrush="{StaticResource AppCardBorder}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <TextBlock Name="txtFileCount"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AppTextPrimary}"
                                       Text="0"
                                       TextAlignment="Center" />
                        </Border>
                    </StackPanel>
                    <AdornerDecorator>
                        <ListBox Name="lstSourceFile"
                                 Height="120"
                                 AllowDrop="True"
                                 Drop="OnSourceFileDrop"
                                 PreviewDragEnter="OnSourceFilePreviewDragEnter"
                                 PreviewDragOver="OnSourceFilePreviewDragOver"
                                 SelectionChanged="OnSourceSelectionChanged"
                                 SelectionMode="Single"
                                 SourceUpdated="OnSourceUpdated">
                            <local:WatermarkService.Watermark>
                                <TextBlock Text="Browse to select or drag/drop the input SVG files" />
                            </local:WatermarkService.Watermark>
                        </ListBox>
                    </AdornerDecorator>
                </DockPanel>

                <TextBlock Margin="0,0,0,4"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AppTextPrimary}"
                           Text="Output Directory" />
                <DockPanel Margin="0,0,0,8" LastChildFill="True">
                    <Button Name="btnOutputDir"
                            Margin="4,0,0,0"
                            Click="OnOutputDirClick"
                            Content="Browse..."
                            DockPanel.Dock="Right" />
                    <AdornerDecorator>
                        <TextBox Name="txtOutputDir" TextChanged="OnDirTextChanged">
                            <local:WatermarkService.Watermark>
                                <TextBlock Text="Type or browse to select the output directory" />
                            </local:WatermarkService.Watermark>
                        </TextBox>
                    </AdornerDecorator>
                </DockPanel>

                <Border Margin="0,0,0,8"
                        Padding="10,8"
                        Background="#100078D7"
                        BorderBrush="{StaticResource AppAccent}"
                        BorderThickness="1"
                        CornerRadius="4">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,4" Orientation="Horizontal">
                            <TextBlock Margin="0,0,6,0"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="16"
                                       Foreground="{StaticResource AppAccent}"
                                       Text="&#xE946;" />
                            <TextBlock FontWeight="SemiBold"
                                       Foreground="{StaticResource AppTextPrimary}"
                                       Text="Note" />
                        </StackPanel>
                        <TextBlock Foreground="{StaticResource AppTextSecondary}" TextWrapping="Wrap">
                            <Run Text="If the output directory is not specified, the converted file will be saved in the same directory as the source file." /><LineBreak />
                            <Run Text="If the source directory is " /><Bold>read-only</Bold><Run Text=" media, the output directory is required." /><LineBreak />
                            <Run Text="If a file name is included, it will be treated as part of the directory." />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource AppCardBackground}"
                        BorderBrush="{StaticResource AppCardBorder}"
                        BorderThickness="1"
                        CornerRadius="4">
                    <StackPanel>
                        <Border Style="{StaticResource CardHeader}">
                            <TextBlock FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AppTextPrimary}"
                                       Text="File List Options" />
                        </Border>
                        <StackPanel Margin="12">
                            <CheckBox Name="chkContinueOnError" IsChecked="True">
                                <TextBlock Foreground="{StaticResource AppTextSecondary}"
                                           Text="Continue if an error occurs in the conversion of a file."
                                           TextWrapping="Wrap" />
                            </CheckBox>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Page>
