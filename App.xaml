<Application
    x:Class="SvgXaml.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    ThemeMode="System">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="AppTextPrimary" Color="#FF1B1B1B"/>
            <SolidColorBrush x:Key="AppTextSecondary" Color="#FF616161"/>
            <SolidColorBrush x:Key="AppOnAccent" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="AppCardBackground" Color="#FFF6F6F6"/>
            <SolidColorBrush x:Key="AppCardBorder" Color="#FFD6D6D6"/>
            <SolidColorBrush x:Key="AppCardHeaderBackground" Color="#FFE8E8E8"/>
            <SolidColorBrush x:Key="AppNavHover" Color="#0E000000"/>
            <SolidColorBrush x:Key="AppNavSelected" Color="#1A000000"/>
            <SolidColorBrush x:Key="AppStatusBarBackground" Color="#FFF3F3F3"/>
            <SolidColorBrush x:Key="AppAccent" Color="#FF0078D7"/>

            <Style x:Key="CardHeader" TargetType="{x:Type Border}">
                <Setter Property="CornerRadius" Value="4,4,0,0"/>
                <Setter Property="Padding" Value="12,6"/>
                <Setter Property="Background" Value="{StaticResource AppCardHeaderBackground}"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
