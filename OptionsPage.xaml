<Page x:Class="SharpVectors.Converters.OptionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Options Page" Height="518" Width="475" VerticalAlignment="Stretch" HorizontalAlignment="Left">
    <Page.Resources>
        <Style x:Key="GroupBoxHeader" TargetType="{x:Type Border}">
            <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
            <Setter Property="TextBlock.Style" Value="{StaticResource BodyStrongTextBlockStyle}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
    </Page.Resources>
    <Grid VerticalAlignment="Top" RowDefinitions="Auto,Auto,Auto,12,Auto,12,Auto">
        <TextBlock Text="Conversion Options" Grid.Row="0" Padding="4" Margin="4"
                   Style="{StaticResource TitleTextBlockStyle}"/>
        <TextBlock Grid.Row="1" Padding="4" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap">
            <Run>
                This is the conversion options page. All settings here will
                affect each conversion process.
            </Run>
        </TextBlock>
        <StackPanel Orientation="Vertical" Grid.Row="2" Margin="4,16,4,4">
            <CheckBox Name="chkTextAsGeometry" IsChecked="True" Click="OnOptionChanged">
                <TextBlock Text="Convert text as path geometry" Style="{StaticResource BodyStrongTextBlockStyle}"/>
            </CheckBox>
            <TextBlock Padding="32,4,4,4" Style="{StaticResource BodyTextBlockStyle}">
                All SVG text elements will be converted to paths.
            </TextBlock>
            <CheckBox Name="chkIncludeRuntime" Click="OnOptionChanged">
                <TextBlock Text="Include support for SharpVectors Runtime library" Style="{StaticResource BodyStrongTextBlockStyle}"/>
            </CheckBox>
            <TextBlock Padding="32,4,4,4" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap">
                <Run>
                    Select this if you want to link to the SharpVectors Runtime library.
                </Run>
                <LineBreak/>
                <Bold>NOTE:&#160;</Bold>
                <Run>
                    If this option is not selected, then select the option to render
                    text as geometric paths; otherwise, font locations may not be resolved
                    properly on the end-user system.
                </Run>
            </TextBlock>
        </StackPanel>
        <GroupBox Name="grpXaml" Grid.Row="4" Padding="4,16,4,4" Margin="8">
            <GroupBox.Header>
                <Border Style="{StaticResource GroupBoxHeader}">
                    <CheckBox Name="chkXaml" IsChecked="True" Click="OnOptionChanged">
                        <TextBlock Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" Text="Generate WPF/XAML"/>
                    </CheckBox>
                </Border>
            </GroupBox.Header>
            <StackPanel Name="panelXaml" Orientation="Vertical">
                <CheckBox Name="chkSameXaml" IsChecked="True" Margin="4" Click="OnOptionChanged">
                    <TextBlock Text="Uncompressed XAML file format (*.xaml)" Style="{StaticResource BodyTextBlockStyle}"/>
                </CheckBox>
                <CheckBox Name="chkSameZaml" Margin="4" Click="OnOptionChanged">
                    <TextBlock Text="Compressed XAML file format (*.zaml)" Style="{StaticResource BodyTextBlockStyle}"/>
                </CheckBox>
                <CheckBox Name="chkXamlWriter" IsChecked="True" Margin="4" Click="OnOptionChanged">
                    <TextBlock Text="Use customized XAML format writer" Style="{StaticResource BodyTextBlockStyle}"/>
                </CheckBox>
                <TextBlock TextWrapping="Wrap" Margin="32,4,4,4" Style="{StaticResource BodyTextBlockStyle}">
                    <Run>
                        The customized XAML writer is an implementation of XamlWriter
                        optimized for the SVG-WPF conversion. You can unselect this
                        option to use the default .NET framework XamlWriter class.
                    </Run>
                </TextBlock>
            </StackPanel>
        </GroupBox>
        <GroupBox Name="grpImage" Grid.Row="6" Padding="4,16,4,4" Margin="8">
            <GroupBox.Header>
                <Border Style="{StaticResource GroupBoxHeader}">
                    <CheckBox Name="chkImage" Click="OnOptionChanged">
                        <TextBlock Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" Text="Generate Raster Image"/>
                    </CheckBox>
                </Border>
            </GroupBox.Header>
            <StackPanel Name="panelImage" IsEnabled="False" Orientation="Vertical">
                <TextBlock TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}">
                    <Run>Select the image format from the list below:</Run>
                </TextBlock>
                <ComboBox Name="cboImages" Margin="32,4,4,4" IsReadOnly="True" IsEditable="False" SelectedIndex="0" IsEnabled="True">
                    <ComboBoxItem Margin="2">
                        <TextBlock Padding="4" Style="{StaticResource BodyTextBlockStyle}">
                            <Bold>BMP:&#160;</Bold>
                            <Run>Windows Bitmap Format (*.bmp)</Run>
                        </TextBlock>
                    </ComboBoxItem>
                    <ComboBoxItem Margin="2">
                        <TextBlock Padding="4" Style="{StaticResource BodyTextBlockStyle}">
                            <Bold>GIF:&#160;</Bold>
                            <Run>Graphics Interchange Format (*.gif)</Run>
                        </TextBlock>
                    </ComboBoxItem>
                    <ComboBoxItem Margin="2">
                        <TextBlock Padding="4" Style="{StaticResource BodyTextBlockStyle}">
                            <Bold>JPEG:&#160;</Bold>
                            <Run>Joint Photographics Experts Group Format (*.jpg)</Run>
                        </TextBlock>
                    </ComboBoxItem>
                    <ComboBoxItem Margin="2" IsSelected="True">
                        <TextBlock Padding="4" Style="{StaticResource BodyTextBlockStyle}">
                            <Bold>PNG:&#160;</Bold>
                            <Run>Portable Network Graphics Format (*.png)</Run>
                        </TextBlock>
                    </ComboBoxItem>
                    <ComboBoxItem Margin="2">
                        <TextBlock Padding="4" Style="{StaticResource BodyTextBlockStyle}">
                            <Bold>TIFF:&#160;</Bold>
                            <Run>Tagged Image File Format (*.tif)</Run>
                        </TextBlock>
                    </ComboBoxItem>
                    <ComboBoxItem Margin="2">
                        <TextBlock Padding="4" Style="{StaticResource BodyTextBlockStyle}">
                            <Bold>WDP:&#160;</Bold>
                            <Run>Windows Media Photo Format (*.wdp)</Run>
                        </TextBlock>
                    </ComboBoxItem>
                </ComboBox>
            </StackPanel>
        </GroupBox>
    </Grid>
</Page>
