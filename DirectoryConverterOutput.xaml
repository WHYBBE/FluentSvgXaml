<Page x:Class="FluentSvgXaml.DirectoryConverterOutput"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Directory Converter Output">
    <DockPanel LastChildFill="True">
        <Button Name="btnCancel" IsEnabled="False" DockPanel.Dock="Bottom"
                HorizontalAlignment="Center" Padding="24,6"
                Content="Cancel" Click="OnCancelClick"/>
        <TextBox Name="txtOutput" Margin="0,8,4,8" IsReadOnly="True" AcceptsReturn="True"
                         HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
    </DockPanel>
</Page>
