<Window x:Class="SharpVectors.Converters.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:SharpVectors.Converters"
    Title="SvgXaml" Height="640" Width="720"
    local:MainWindowSettings.Save="True"
    WindowStartupLocation="CenterScreen"
    ResizeMode="CanResizeWithGrip"
    Icon="/SvgXaml;component/Images/SharpVectors.ico">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="VerticalTab.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel LastChildFill="True">
        <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorSecondaryBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource OverlayCornerRadius}"
                SnapsToDevicePixels="True" DockPanel.Dock="Bottom" Padding="8,4">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <local:CircularProgressBar x:Name="filesProgressBar" Margin="4,0" Height="20" StartupDelay="0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                    <local:CircularProgressBar x:Name="filesListProgressBar" Margin="4,0" Height="20" StartupDelay="0" Foreground="{DynamicResource AccentTextFillColorSecondaryBrush}"/>
                    <local:CircularProgressBar x:Name="dirsProgressBar" Margin="4,0" Height="20" StartupDelay="0" Foreground="{DynamicResource AccentTextFillColorTertiaryBrush}"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{DynamicResource AccentButtonStyle}" Content="Close" VerticalAlignment="Center" Padding="16,4" Click="OnClickClosed"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <TabControl Name="tabSteps" Template="{StaticResource VerticalTabControl}">
            <TabItem Header="Start Page" FocusVisualStyle="{x:Null}">
                <Frame Name="startupFrame" NavigationUIVisibility="Visible" Source="StartPage.xaml"/>
            </TabItem>
            <TabItem Header="Files" FocusVisualStyle="{x:Null}">
                <Frame Name="filesFrame" NavigationUIVisibility="Visible"/>
            </TabItem>
            <TabItem Header="Files List" FocusVisualStyle="{x:Null}">
                <Frame Name="filesListFrame" NavigationUIVisibility="Visible"/>
            </TabItem>
            <TabItem Header="Directories" FocusVisualStyle="{x:Null}">
                <Frame Name="directoriesFrame" NavigationUIVisibility="Visible"/>
            </TabItem>
            <TabItem Header="Options" FocusVisualStyle="{x:Null}">
                <Frame Name="optionsFrame" NavigationUIVisibility="Hidden"/>
            </TabItem>
            <TabItem Header="Help" FocusVisualStyle="{x:Null}">
                <Frame Name="helpFrame" NavigationUIVisibility="Hidden" Source="HelpPage.xaml"/>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
